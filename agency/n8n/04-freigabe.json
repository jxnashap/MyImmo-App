{
  "name": "AI Agency · 04 Freigabe & Ausführung",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "agency-freigabe",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n-0037",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -620,
        300
      ],
      "webhookId": "agency-agency-freigabe"
    },
    {
      "parameters": {
        "jsCode": "// ===== HIER ANPASSEN (der einzige Ort je Workflow) =====\nconst cfg = {\n  supabaseUrl:  'https://DEIN-AGENCY-REF.supabase.co',\n  auditorUrl:   'https://DEIN-N8N/webhook/agency-auditor',\n  freigabeUrl:  'https://DEIN-N8N/webhook/agency-freigabe',\n  kennzahlenUrl:'https://www.myimmoapp.de/api/intern/kennzahlen',\n  mailAn:       'DEINE@MAIL.DE',\n  mailVon:      'agency@myimmoapp.de',\n  mailVonName:  'MyImmo Agency',\n  githubRepo:   'jxnashap/myimmo-app',\n};\n// =======================================================\nconst q = $input.first().json.query ?? {};\nif (!q.vorgang || !q.token || !q.entscheidung) {\n  throw new Error('Link unvollständig: vorgang, token und entscheidung nötig');\n}\nreturn [{ json: { ...cfg, ...q } }];"
      },
      "id": "n-0038",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Konfiguration').first().json.supabaseUrl }}/rest/v1/rpc/agency_freigabe",
        "options": {
          "timeout": 300000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_vorgang: $json.vorgang, p_token: $json.token, p_entscheidung: $json.entscheidung }) }}"
      },
      "id": "n-0039",
      "name": "Freigabe buchen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "AGENCY_SUPABASE",
          "name": "Agency Supabase"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-0040",
              "leftValue": "={{ $json.ok === true && $json.entscheidung === 'ja' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "n-0041",
      "name": "Freigegeben?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $('Konfiguration').first().json.githubRepo }}/issues",
        "options": {
          "timeout": 300000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: '[Agency #' + $json.nr + '] ' + $json.titel, body: ($json.ergebnis || '(kein Ergebnis)') + '\\n\\n---\\nFreigegeben über den AI-Agency-Workflow. Umsetzung in Claude Code auf einem eigenen Branch, PR wie üblich.', labels: ['agency'] }) }}"
      },
      "id": "n-0042",
      "name": "GitHub-Issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_TOKEN",
          "name": "GitHub Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const f = $('Freigabe buchen').first().json;\nconst g = $input.first().json;\nconst nr = g?.number ? ' · GitHub-Issue #' + g.number : '';\nreturn [{ json: { html:\n  '<!doctype html><meta charset=\"utf-8\"><title>Freigegeben</title>'\n  + '<div style=\"font-family:system-ui,sans-serif;max-width:520px;margin:12vh auto;text-align:center\">'\n  + '<div style=\"font-size:40px\">✓</div>'\n  + '<h1 style=\"font-weight:600;font-size:20px\">Vorgang #' + f.nr + ' freigegeben</h1>'\n  + '<p style=\"color:#666\">' + (f.titel ?? '') + nr + '</p>'\n  + '<p style=\"color:#666;font-size:13px\">Dieses Fenster kann geschlossen werden.</p></div>' } }];"
      },
      "id": "n-0043",
      "name": "Seite ja",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.html }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "content-type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "n-0044",
      "name": "Antwort ja",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst titel = f.ok === false ? 'Nicht möglich' : 'Abgelehnt';\nconst text  = f.ok === false ? (f.fehler ?? 'unbekannter Fehler')\n                             : 'Vorgang #' + f.nr + ' wurde verworfen.';\nreturn [{ json: { html:\n  '<!doctype html><meta charset=\"utf-8\"><title>' + titel + '</title>'\n  + '<div style=\"font-family:system-ui,sans-serif;max-width:520px;margin:12vh auto;text-align:center\">'\n  + '<h1 style=\"font-weight:600;font-size:20px\">' + titel + '</h1>'\n  + '<p style=\"color:#666\">' + text + '</p></div>' } }];"
      },
      "id": "n-0045",
      "name": "Seite nein",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        460
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.html }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "content-type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "n-0046",
      "name": "Antwort nein",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        460
      ]
    }
  ],
